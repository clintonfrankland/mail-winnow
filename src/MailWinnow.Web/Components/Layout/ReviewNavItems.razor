@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IMessageReviewService ReviewService

<div class="nav-item"><NavLink class="nav-link" href="review" Match="NavLinkMatch.All"><span class="nav-icon" aria-hidden="true">✓</span> Review - Recent @if (_messageCount > 0) { <span class="review-count" aria-label="@_messageCount pending messages">@_messageCount</span> }</NavLink></div>
<div class="nav-item"><NavLink class="nav-link" href="review/sender"><span class="nav-icon" aria-hidden="true">☷</span> Review - Sender @if (_senderCount > 0) { <span class="review-count" aria-label="@_senderCount pending senders">@_senderCount</span> }</NavLink></div>

@code {
    [CascadingParameter] public Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;
    private int _messageCount;
    private int _senderCount;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateTask).User;
        var filter = new MessageReviewFilter(null, RuleOutcome.Pending, null);
        var messages = await ReviewService.GetRecentAsync(user, filter);
        _messageCount = messages.Count;
        _senderCount = messages.Select(message => message.Sender).Distinct(StringComparer.OrdinalIgnoreCase).Count();
    }
}
