<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">MailWinnow.Web</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <AuthorizeView Roles="Administrator">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/household">
                    <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> Household
                </NavLink>
            </div>
        </AuthorizeView>
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3"><NavLink class="nav-link" href="mailboxes">Mailboxes</NavLink></div>
                <div class="nav-item px-3">
                    <form method="post" action="/auth/logout">
                        <AntiforgeryToken />
                        <button class="nav-link btn btn-link" type="submit">Sign out</button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3"><NavLink class="nav-link" href="login">Sign in</NavLink></div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>
