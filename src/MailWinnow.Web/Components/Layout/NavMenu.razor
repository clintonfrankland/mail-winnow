@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Security.Claims
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IServiceScopeFactory ScopeFactory
@inject NavigationCountState CountState
@inject ILogger<NavMenu> Logger
@implements IAsyncDisposable

<div class="brand-row"><a class="brand" href="" aria-label="Mail Winnow home"><img class="brand-mark brand-mark-plain" src="mail-winnow-mark-bordered.png" alt="" /><span><strong>Mail Winnow</strong><small>Mail worth keeping</small></span></a></div>
<input type="checkbox" title="Navigation menu" class="navbar-toggler" aria-label="Toggle navigation" />
<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav" aria-label="Primary navigation">
        <AuthorizeView>
            <Authorized>
                <div class="nav-item"><NavLink class="nav-link" href="inbox"><span class="nav-icon" aria-hidden="true">▤</span> Inbox @if (CountState.InboxCount > 0) { <span class="sidebar-count" aria-label="@CountState.InboxCount inbox messages">@CountState.InboxCount</span> }</NavLink></div>
                <div class="nav-item"><NavLink class="nav-link" href="review" Match="NavLinkMatch.All"><span class="nav-icon" aria-hidden="true">✓</span> Review - Recent @if (CountState.ReviewMessageCount > 0) { <span class="sidebar-count" aria-label="@CountState.ReviewMessageCount pending messages">@CountState.ReviewMessageCount</span> }</NavLink></div>
                <div class="nav-item"><NavLink class="nav-link" href="review/sender"><span class="nav-icon" aria-hidden="true">☷</span> Review - Sender @if (CountState.ReviewSenderCount > 0) { <span class="sidebar-count" aria-label="@CountState.ReviewSenderCount pending senders">@CountState.ReviewSenderCount</span> }</NavLink></div>
                <div class="nav-item"><NavLink class="nav-link" href="rules"><span class="nav-icon" aria-hidden="true">⚙</span> Rules</NavLink></div>
                <div class="nav-item"><NavLink class="nav-link" href="mailboxes"><span class="nav-icon" aria-hidden="true">✉</span> Mailboxes</NavLink></div>
                <div class="nav-item"><NavLink class="nav-link" href="outbox"><span class="nav-icon" aria-hidden="true">↗</span> Drafts &amp; Outbox</NavLink></div>
                <div class="nav-item"><NavLink class="nav-link" href="sending"><span class="nav-icon" aria-hidden="true">⚙</span> Sending accounts</NavLink></div>
                <div class="app-version" aria-label="Mail Winnow version @AppVersion">v@(AppVersion)</div>
                <div class="nav-item nav-signout"><form method="post" action="/auth/logout"><AntiforgeryToken /><button class="nav-link" type="submit"><span class="nav-icon" aria-hidden="true">↪</span> Sign out</button></form></div>
            </Authorized>
            <NotAuthorized><div class="nav-item"><NavLink class="nav-link" href="login"><span class="nav-icon" aria-hidden="true">↪</span> Sign in</NavLink></div></NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private static readonly TimeSpan CountRefreshInterval = TimeSpan.FromSeconds(15);
    private readonly CancellationTokenSource _refreshCancellation = new();
    private Task? _refreshTask;
    private static string AppVersion => typeof(Program).Assembly.GetName().Version?.ToString() ?? "unknown";

    protected override void OnInitialized()
    {
        CountState.Changed += OnCountsChanged;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _refreshTask = LoadCountsAsync();
        }

        return Task.CompletedTask;
    }

    private async Task LoadCountsAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        if (user.Identity?.IsAuthenticated != true)
        {
            return;
        }

        await NavigationCountLoader.RunAsync(
            token => LoadInboxCountAsync(user, token),
            token => LoadReviewCountsAsync(user, token),
            CountRefreshInterval,
            _refreshCancellation.Token);
    }

    private async Task LoadInboxCountAsync(ClaimsPrincipal user, CancellationToken cancellationToken)
    {
        try
        {
            await using (var inboxScope = ScopeFactory.CreateAsyncScope())
            {
                var revision = CountState.InboxRevision;
                var inbox = await inboxScope.ServiceProvider.GetRequiredService<INavigationCountService>()
                    .GetInboxCountAsync(user, cancellationToken);
                if (inbox.HasValue)
                {
                    CountState.ApplyInboxRefresh(inbox.Value, revision);
                }
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Inbox navigation count could not be loaded");
        }
    }

    private async Task LoadReviewCountsAsync(ClaimsPrincipal user, CancellationToken cancellationToken)
    {
        try
        {
            await using var reviewScope = ScopeFactory.CreateAsyncScope();
            var revision = CountState.ReviewRevision;
            var counts = await reviewScope.ServiceProvider.GetRequiredService<INavigationCountService>()
                .GetReviewCountsAsync(user, cancellationToken);
            CountState.ApplyReviewRefresh(counts.Messages, counts.Senders, revision);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Review navigation counts could not be loaded");
        }
    }

    private void OnCountsChanged() => _ = InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        CountState.Changed -= OnCountsChanged;
        await _refreshCancellation.CancelAsync();

        if (_refreshTask is not null)
        {
            await _refreshTask;
        }

        _refreshCancellation.Dispose();
    }
}
