@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IServiceScopeFactory ScopeFactory
@inject NavigationCountState CountState
@implements IDisposable

<div class="brand-row"><a class="brand" href="" aria-label="Mail Winnow home"><span class="brand-mark">MW</span><span><strong>Mail Winnow</strong><small>Selective delivery</small></span></a></div>
<input type="checkbox" title="Navigation menu" class="navbar-toggler" aria-label="Toggle navigation" />
<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav" aria-label="Primary navigation">
        <AuthorizeView>
            <Authorized>
                <div class="nav-item"><NavLink class="nav-link" href="inbox"><span class="nav-icon" aria-hidden="true">▤</span> Inbox @if (CountState.InboxCount > 0) { <span class="sidebar-count" aria-label="@CountState.InboxCount inbox messages">@CountState.InboxCount</span> }</NavLink></div>
                <div class="nav-item"><NavLink class="nav-link" href="review" Match="NavLinkMatch.All"><span class="nav-icon" aria-hidden="true">✓</span> Review - Recent @if (CountState.ReviewMessageCount > 0) { <span class="sidebar-count" aria-label="@CountState.ReviewMessageCount pending messages">@CountState.ReviewMessageCount</span> }</NavLink></div>
                <div class="nav-item"><NavLink class="nav-link" href="review/sender"><span class="nav-icon" aria-hidden="true">☷</span> Review - Sender @if (CountState.ReviewSenderCount > 0) { <span class="sidebar-count" aria-label="@CountState.ReviewSenderCount pending senders">@CountState.ReviewSenderCount</span> }</NavLink></div>
                <div class="nav-item"><NavLink class="nav-link" href="rules"><span class="nav-icon" aria-hidden="true">⚙</span> Rules</NavLink></div>
                <div class="nav-item"><NavLink class="nav-link" href="mailboxes"><span class="nav-icon" aria-hidden="true">✉</span> Mailboxes</NavLink></div>
                <div class="app-version" aria-label="Mail Winnow version @AppVersion">v@(AppVersion)</div>
                <div class="nav-item nav-signout"><form method="post" action="/auth/logout"><AntiforgeryToken /><button class="nav-link" type="submit"><span class="nav-icon" aria-hidden="true">↪</span> Sign out</button></form></div>
            </Authorized>
            <NotAuthorized><div class="nav-item"><NavLink class="nav-link" href="login"><span class="nav-icon" aria-hidden="true">↪</span> Sign in</NavLink></div></NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private static string AppVersion => typeof(Program).Assembly.GetName().Version?.ToString() ?? "unknown";

    protected override async Task OnInitializedAsync()
    {
        CountState.Changed += OnCountsChanged;
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        if (user.Identity?.IsAuthenticated != true)
        {
            return;
        }

        await using (var inboxScope = ScopeFactory.CreateAsyncScope())
        {
            var inbox = await inboxScope.ServiceProvider.GetRequiredService<IInboxReaderService>().CountAsync(user);
            if (inbox.Succeeded)
            {
                CountState.SetInboxCount(inbox.Value);
            }
        }

        await using var reviewScope = ScopeFactory.CreateAsyncScope();
        var messages = await reviewScope.ServiceProvider.GetRequiredService<IMessageReviewService>()
            .GetRecentAsync(user, new MessageReviewFilter(null, RuleOutcome.Pending, null));
        CountState.SetReviewCounts(messages.Count,
            messages.Select(message => message.Sender).Distinct(StringComparer.OrdinalIgnoreCase).Count());
    }

    private void OnCountsChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => CountState.Changed -= OnCountsChanged;
}
