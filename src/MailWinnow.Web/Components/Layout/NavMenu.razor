@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IServiceScopeFactory ScopeFactory

<div class="brand-row"><a class="brand" href="" aria-label="Mail Winnow home"><span class="brand-mark">MW</span><span><strong>Mail Winnow</strong><small>Selective delivery</small></span></a></div>
<input type="checkbox" title="Navigation menu" class="navbar-toggler" aria-label="Toggle navigation" />
<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav" aria-label="Primary navigation">
        <AuthorizeView>
            <Authorized>
                <div class="nav-item"><NavLink class="nav-link" href="inbox"><span class="nav-icon" aria-hidden="true">▤</span> Inboxes @if (_inboxCount > 0) { <span class="sidebar-count" aria-label="@_inboxCount inbox messages">@_inboxCount</span> }</NavLink></div>
                <div class="nav-item"><NavLink class="nav-link" href="review" Match="NavLinkMatch.All"><span class="nav-icon" aria-hidden="true">✓</span> Review - Recent @if (_messageCount > 0) { <span class="sidebar-count" aria-label="@_messageCount pending messages">@_messageCount</span> }</NavLink></div>
                <div class="nav-item"><NavLink class="nav-link" href="review/sender"><span class="nav-icon" aria-hidden="true">☷</span> Review - Sender @if (_senderCount > 0) { <span class="sidebar-count" aria-label="@_senderCount pending senders">@_senderCount</span> }</NavLink></div>
                <div class="nav-item"><NavLink class="nav-link" href="rules"><span class="nav-icon" aria-hidden="true">⚙</span> Rules</NavLink></div>
                <div class="nav-item"><NavLink class="nav-link" href="mailboxes"><span class="nav-icon" aria-hidden="true">✉</span> Mailboxes</NavLink></div>
                <div class="nav-item nav-signout"><form method="post" action="/auth/logout"><AntiforgeryToken /><button class="nav-link" type="submit"><span class="nav-icon" aria-hidden="true">↪</span> Sign out</button></form></div>
            </Authorized>
            <NotAuthorized><div class="nav-item"><NavLink class="nav-link" href="login"><span class="nav-icon" aria-hidden="true">↪</span> Sign in</NavLink></div></NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private int _inboxCount;
    private int _messageCount;
    private int _senderCount;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
        if (user.Identity?.IsAuthenticated != true)
        {
            return;
        }

        await using (var inboxScope = ScopeFactory.CreateAsyncScope())
        {
            var inbox = await inboxScope.ServiceProvider.GetRequiredService<IInboxReaderService>().CountAsync(user);
            if (inbox.Succeeded)
            {
                _inboxCount = inbox.Value;
            }
        }

        await using var reviewScope = ScopeFactory.CreateAsyncScope();
        var messages = await reviewScope.ServiceProvider.GetRequiredService<IMessageReviewService>()
            .GetRecentAsync(user, new MessageReviewFilter(null, RuleOutcome.Pending, null));
        _messageCount = messages.Count;
        _senderCount = messages.Select(message => message.Sender).Distinct(StringComparer.OrdinalIgnoreCase).Count();
    }
}
