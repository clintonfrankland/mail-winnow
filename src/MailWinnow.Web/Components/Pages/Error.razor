@page "/Error"
@using System.Diagnostics
<PageTitle>Something went wrong</PageTitle><section class="card error-state"><div class="error-code">!</div><h1>We couldn't complete that request</h1><p class="text-body-secondary">Mail Winnow encountered an unexpected problem. Your data remains protected. Try again, or share the reference below with the administrator.</p>@if (ShowRequestId){<p><strong>Reference:</strong> <code>@RequestId</code></p>}<a class="btn btn-primary" href="">Return to overview</a></section>
@code { [CascadingParameter] private HttpContext? HttpContext { get; set; } private string? RequestId { get; set; } private bool ShowRequestId=>!string.IsNullOrEmpty(RequestId); protected override void OnInitialized()=>RequestId=Activity.Current?.Id??HttpContext?.TraceIdentifier; }
