@page "/review"
@attribute [Authorize]
@inject IMessageReviewService ReviewService
@inject IMailboxConfigurationService MailboxService

<PageTitle>Message review</PageTitle>
<header class="page-heading"><div class="eyebrow">Decision center</div><h1>Message review</h1><p>Review recent mail and turn one-time decisions into reusable household rules.</p></header>
@if (!string.IsNullOrWhiteSpace(Error)) { <div class="alert alert-danger" role="alert">@Error</div> }
@if (!string.IsNullOrWhiteSpace(Saved)) { <div class="alert alert-success" role="status">@Saved</div> }

<form method="get" class="card section-card review-filter" aria-label="Message filters">
    <input type="hidden" name="view" value="@View" />
    <label>Account <select class="form-select" name="sourceMailboxId"><option value="">All accounts</option>@foreach (var source in _sources) { <option value="@source.Id" selected="@(SourceMailboxId == source.Id)">@source.DisplayName</option> }</select></label>
    <label>Status <select class="form-select" name="outcome"><option value="">All statuses</option><option value="Pending" selected="@(Outcome == RuleOutcome.Pending)">Pending review</option><option value="Allow" selected="@(Outcome == RuleOutcome.Allow)">Allowed</option><option value="Block" selected="@(Outcome == RuleOutcome.Block)">Blocked</option></select></label>
    <label>Sender or subject <input class="form-control" name="search" value="@Search" /></label>
    <button class="btn btn-primary">Apply filters</button>
</form>

<nav class="tabs mb-3" aria-label="Review view"><a class="btn @(View == "recent" ? "btn-primary" : "btn-outline-primary")" href="@Link("recent")">Recent</a><a class="btn @(View == "sender" ? "btn-primary" : "btn-outline-primary")" href="@Link("sender")">By sender</a><a class="btn @(View == "subject" ? "btn-primary" : "btn-outline-primary")" href="@Link("subject")">By subject</a></nav>

@if (View == "recent")
{
    <p class="text-body-secondary small">Newest first. Review and delivery status are tracked separately.</p>
    @foreach (var item in _recent)
    {
        <article class="card review-card mb-2"><div class="review-card-header"><div><h2 class="h5">@item.Subject</h2><div class="review-meta">@item.Sender · @item.Account · @item.ReceivedUtc.ToString("u")</div></div><span class="pill">@item.Outcome</span></div><div class="review-facts"><div><strong>Source</strong>@item.SourceStatus</div><div><strong>Local delivery</strong>@item.DeliveryStatus</div><div><strong>Rule</strong>@item.RuleContext</div><div><strong>Retention</strong>@item.RetentionContext</div></div><div class="decision-actions">
            <form method="post" action="/review/message/approve" class="d-inline"><AntiforgeryToken /><input type="hidden" name="Id" value="@item.Id" /><button class="btn btn-sm btn-success mt-2">Approve this message</button></form>
            <form method="post" action="/review/rule" class="d-inline"><AntiforgeryToken /><input type="hidden" name="MatchValue" value="@item.Sender" /><input type="hidden" name="MatchType" value="ExactSender" /><select name="RetentionDays" aria-label="Destination retention"><option value="">Forever</option><option value="30">1 month</option><option value="7">1 week</option><option value="3">3 days</option><option value="1">1 day</option></select><button name="Action" value="PermanentlyAllow" class="btn btn-sm btn-outline-success mt-2">Allow from address @item.Sender</button></form>
            <form method="post" action="/review/rule" class="d-inline"><AntiforgeryToken /><input type="hidden" name="MatchValue" value="@item.Sender" /><input type="hidden" name="MatchType" value="ExactSender" /><button name="Action" value="PermanentlyBlock" class="btn btn-sm btn-outline-danger mt-2">Block sender @item.Sender</button></form>
            @if (SenderDomain(item.Sender) is { } domain) { <form method="post" action="/review/rule" class="d-inline"><AntiforgeryToken /><input type="hidden" name="MatchValue" value="@domain" /><input type="hidden" name="MatchType" value="SenderDomain" /><select name="RetentionDays" aria-label="Destination retention"><option value="">Forever</option><option value="30">1 month</option><option value="7">1 week</option><option value="3">3 days</option><option value="1">1 day</option></select><button name="Action" value="PermanentlyAllow" class="btn btn-sm btn-outline-success mt-2">Allow from domain @domain</button></form> }
            @if (SenderDomain(item.Sender) is { } blockedDomain) { <form method="post" action="/review/rule" class="d-inline"><AntiforgeryToken /><input type="hidden" name="MatchValue" value="@blockedDomain" /><input type="hidden" name="MatchType" value="SenderDomain" /><button name="Action" value="PermanentlyBlock" class="btn btn-sm btn-outline-danger mt-2">Block domain @blockedDomain</button></form> }
            <form method="post" action="/review/message/undo" class="d-inline"><AntiforgeryToken /><input type="hidden" name="Id" value="@item.Id" /><button class="btn btn-sm btn-outline-secondary mt-2">Undo one-message decision</button></form>
            @if (item.DeliveryId is { } deliveryId && item.DeliveryStatus.StartsWith("Failed", StringComparison.Ordinal)) { <form method="post" action="/review/delivery/retry" class="d-inline"><AntiforgeryToken /><input type="hidden" name="Id" value="@deliveryId" /><button class="btn btn-sm btn-outline-warning mt-2">Retry delivery</button></form> }
        </div>
        </article>
    }
}
else
{
    var groups = View == "sender" ? _senders : _subjects;
    @foreach (var group in groups) { <article class="card review-card mb-2"><div class="review-card-header"><h2 class="h5">@group.Value</h2><span class="pill">@group.Count messages</span></div><div class="review-meta">Newest @group.MostRecentUtc.ToString("u")</div><div class="review-facts"><div><strong>Samples</strong>@string.Join("; ", group.Samples)</div><div><strong>Matching context</strong>@string.Join("; ", group.RuleContexts)</div></div><div class="decision-actions">
        <form method="post" action="/review/messages/approve" class="d-inline"><AntiforgeryToken />@foreach (var id in group.MessageIds) { <input type="hidden" name="Ids" value="@id" /> }<button class="btn btn-sm btn-success mt-2">Approve these messages</button></form>
        @foreach (var sender in group.Senders) {
            <form method="post" action="/review/rule" class="d-inline"><AntiforgeryToken /><input type="hidden" name="MatchValue" value="@sender" /><input type="hidden" name="MatchType" value="ExactSender" /><select name="RetentionDays" aria-label="Destination retention"><option value="">Forever</option><option value="30">1 month</option><option value="7">1 week</option><option value="3">3 days</option><option value="1">1 day</option></select><button name="Action" value="PermanentlyAllow" class="btn btn-sm btn-outline-success mt-2">Allow from address @sender</button></form>
            <form method="post" action="/review/rule" class="d-inline"><AntiforgeryToken /><input type="hidden" name="MatchValue" value="@sender" /><input type="hidden" name="MatchType" value="ExactSender" /><button name="Action" value="PermanentlyBlock" class="btn btn-sm btn-outline-danger mt-2">Block sender @sender</button></form>
            @if (SenderDomain(sender) is { } domain) { <form method="post" action="/review/rule" class="d-inline"><AntiforgeryToken /><input type="hidden" name="MatchValue" value="@domain" /><input type="hidden" name="MatchType" value="SenderDomain" /><select name="RetentionDays" aria-label="Destination retention"><option value="">Forever</option><option value="30">1 month</option><option value="7">1 week</option><option value="3">3 days</option><option value="1">1 day</option></select><button name="Action" value="PermanentlyAllow" class="btn btn-sm btn-outline-success mt-2">Allow from domain @domain</button></form> }
            @if (SenderDomain(sender) is { } blockedDomain) { <form method="post" action="/review/rule" class="d-inline"><AntiforgeryToken /><input type="hidden" name="MatchValue" value="@blockedDomain" /><input type="hidden" name="MatchType" value="SenderDomain" /><button name="Action" value="PermanentlyBlock" class="btn btn-sm btn-outline-danger mt-2">Block domain @blockedDomain</button></form> }
        }
    </div></article> }
}

<section class="card section-card mt-3"><div class="section-header"><div><h2>Reusable rules</h2><p class="text-body-secondary mb-0">View, create, edit, or remove automatic decisions on the Rules page.</p></div><a class="btn btn-outline-primary" href="/rules">Manage rules</a></div></section>

@code {
    [CascadingParameter] public HttpContext HttpContext { get; set; } = null!;
    [SupplyParameterFromQuery] public string? View { get; set; }
    [SupplyParameterFromQuery] public Guid? SourceMailboxId { get; set; }
    [SupplyParameterFromQuery(Name = "outcome")] public string? OutcomeQuery { get; set; }
    [SupplyParameterFromQuery] public string? Search { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? Saved { get; set; }
    private IReadOnlyList<SourceMailboxSummary> _sources = [];
    private IReadOnlyList<MessageReviewItem> _recent = [];
    private IReadOnlyList<MessageReviewGroup> _senders = [];
    private IReadOnlyList<MessageReviewGroup> _subjects = [];
    private RuleOutcome? Outcome => ReviewQueryParser.ParseOutcome(OutcomeQuery);
    protected override async Task OnInitializedAsync() { View = View?.ToLowerInvariant() is "sender" or "subject" ? View.ToLowerInvariant() : "recent"; var filter = new MessageReviewFilter(SourceMailboxId, Outcome, Search); _sources = await MailboxService.ListSourcesAsync(HttpContext.User); _recent = await ReviewService.GetRecentAsync(HttpContext.User, filter); if (View == "sender") _senders = await ReviewService.GetBySenderAsync(HttpContext.User, filter); if (View == "subject") _subjects = await ReviewService.GetBySubjectAsync(HttpContext.User, filter); }
    private string Link(string view) => $"/review?view={view}&sourceMailboxId={SourceMailboxId}&outcome={Outcome}&search={Uri.EscapeDataString(Search ?? string.Empty)}";
    private static string? SenderDomain(string sender) { var at = sender.LastIndexOf('@'); return at > 0 && at < sender.Length - 1 ? sender[(at + 1)..] : null; }
}
