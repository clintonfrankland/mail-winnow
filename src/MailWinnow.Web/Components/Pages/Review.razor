@page "/review"
@attribute [Authorize]
@inject IMessageReviewService ReviewService
@inject IMailboxConfigurationService MailboxService

<PageTitle>Message review</PageTitle>
<header class="page-heading"><div class="eyebrow">Decision center</div><h1>Message review</h1><p>Review recent mail and turn one-time decisions into reusable household rules.</p></header>
@if (!string.IsNullOrWhiteSpace(Error)) { <div class="alert alert-danger" role="alert">@Error</div> }
@if (!string.IsNullOrWhiteSpace(Saved)) { <div class="alert alert-success" role="status">@Saved</div> }

<form method="get" class="card section-card review-filter" aria-label="Message filters">
    <input type="hidden" name="view" value="@View" />
    <label>Account <select class="form-select" name="sourceMailboxId"><option value="">All accounts</option>@foreach (var source in _sources) { <option value="@source.Id" selected="@(SourceMailboxId == source.Id)">@source.DisplayName</option> }</select></label>
    <label>Status <select class="form-select" name="outcome"><option value="">All statuses</option><option value="Pending" selected="@(Outcome == RuleOutcome.Pending)">Pending review</option><option value="Allow" selected="@(Outcome == RuleOutcome.Allow)">Allowed</option><option value="Block" selected="@(Outcome == RuleOutcome.Block)">Blocked</option></select></label>
    <label>Sender or subject <input class="form-control" name="search" value="@Search" /></label>
    <button class="btn btn-primary">Apply filters</button>
</form>

<nav class="tabs mb-3" aria-label="Review view"><a class="btn @(View == "recent" ? "btn-primary" : "btn-outline-primary")" href="@Link("recent")">Recent</a><a class="btn @(View == "sender" ? "btn-primary" : "btn-outline-primary")" href="@Link("sender")">By sender</a><a class="btn @(View == "subject" ? "btn-primary" : "btn-outline-primary")" href="@Link("subject")">By subject</a></nav>

@if (View == "recent")
{
    <p class="text-body-secondary small">Newest first. Review and delivery status are tracked separately.</p>
    @foreach (var item in _recent)
    {
        <article class="card review-card mb-2"><div class="review-card-header"><div><h2 class="h5">@item.Subject</h2><div class="review-meta">@item.Sender · @item.Account · @item.ReceivedUtc.ToString("u")</div></div><span class="pill">@item.Outcome</span></div><div class="review-facts"><div><strong>Source</strong>@item.SourceStatus</div><div><strong>Local delivery</strong>@item.DeliveryStatus</div><div><strong>Rule</strong>@item.RuleContext</div><div><strong>Retention</strong>@item.RetentionContext</div></div><div class="decision-actions">
            <form method="post" action="/review/message/approve" class="d-inline"><AntiforgeryToken /><input type="hidden" name="Id" value="@item.Id" /><button class="btn btn-sm btn-success mt-2">Approve this message</button></form>
            <form method="post" action="/review/message/undo" class="d-inline"><AntiforgeryToken /><input type="hidden" name="Id" value="@item.Id" /><button class="btn btn-sm btn-outline-secondary mt-2">Undo one-message decision</button></form>
            @if (item.DeliveryId is { } deliveryId && item.DeliveryStatus.StartsWith("Failed", StringComparison.Ordinal)) { <form method="post" action="/review/delivery/retry" class="d-inline"><AntiforgeryToken /><input type="hidden" name="Id" value="@deliveryId" /><button class="btn btn-sm btn-outline-warning mt-2">Retry delivery</button></form> }
            <details class="d-inline"><summary class="btn btn-sm btn-outline-primary mt-2">Apply to matching</summary><form method="post" action="/review/rule"><AntiforgeryToken /><input type="hidden" name="MatchValue" value="@item.Sender" /><input type="hidden" name="MatchType" value="ExactSender" /><input type="hidden" name="RetentionDays" value="30" /><button name="Action" value="PermanentlyAllow" class="btn btn-sm btn-success">Always allow sender</button><button name="Action" value="PermanentlyBlock" class="btn btn-sm btn-danger">Block sender</button><button name="Action" value="TemporarilyAllow" class="btn btn-sm btn-warning">Allow 7 days</button></form></details>
            @if (SenderDomain(item.Sender) is { } domain) { <form method="post" action="/review/rule" class="d-inline"><AntiforgeryToken /><input type="hidden" name="MatchValue" value="@domain" /><input type="hidden" name="MatchType" value="SenderDomain" /><input type="hidden" name="RetentionDays" value="30" /><button name="Action" value="PermanentlyAllow" class="btn btn-sm btn-outline-success mt-2">Allow domain @domain</button><button name="Action" value="PermanentlyBlock" class="btn btn-sm btn-outline-danger mt-2">Block domain @domain</button></form> }</div>
        </article>
    }
}
else
{
    var groups = View == "sender" ? _senders : _subjects;
    @foreach (var group in groups) { <article class="card review-card mb-2"><div class="review-card-header"><h2 class="h5">@group.Value</h2><span class="pill">@group.Count messages</span></div><div class="review-meta">Newest @group.MostRecentUtc.ToString("u")</div><div class="review-facts"><div><strong>Samples</strong>@string.Join("; ", group.Samples)</div><div><strong>Matching context</strong>@string.Join("; ", group.RuleContexts)</div></div></article> }
}

<div class="section-header mt-3"><div><h2>Reusable decisions</h2><p class="text-body-secondary mb-0">Rules that automatically handle future messages.</p></div></div>
<details class="card section-card mb-3"><summary class="btn btn-outline-primary">Create a domain rule</summary><form method="post" action="/review/rule" class="form-stack mt-3"><AntiforgeryToken /><input type="hidden" name="MatchType" value="SenderDomain" /><input type="hidden" name="RetentionDays" value="30" /><label for="domain-rule">Sender domain</label><input id="domain-rule" class="form-control" name="MatchValue" required placeholder="example.com" /><div class="decision-actions"><button name="Action" value="PermanentlyAllow" class="btn btn-sm btn-success">Always allow domain</button><button name="Action" value="PermanentlyBlock" class="btn btn-sm btn-danger">Block domain</button><button name="Action" value="TemporarilyAllow" class="btn btn-sm btn-warning">Allow domain for 7 days</button></div></form></details>
<h3>Active reusable decisions</h3>
@if (_rules.Count == 0) { <div class="empty-state">No reusable decisions have been created yet.</div> }
@foreach (var rule in _rules) { <article class="card review-card mb-2"><div class="review-card-header"><div><strong>@rule.Action</strong><div class="review-meta">@rule.MatchType · @rule.MatchValue</div></div><span class="pill">@(rule.ExpiresUtc?.ToString("u") ?? "Permanent")</span></div><p class="small text-body-secondary">Delivered-copy deletion: @rule.RetentionDays days after local delivery</p><div class="decision-actions"><form method="post" action="/review/rule/delete"><AntiforgeryToken /><input type="hidden" name="Id" value="@rule.Id" /><button class="btn btn-sm btn-outline-danger">Remove rule</button></form><details><summary class="btn btn-sm btn-outline-secondary">Replace rule</summary><form method="post" action="/review/rule" class="form-stack mt-2"><AntiforgeryToken /><input type="hidden" name="ReplaceRuleId" value="@rule.Id" /><input type="hidden" name="MatchValue" value="@rule.MatchValue" /><input type="hidden" name="MatchType" value="@rule.MatchType" /><label for="retention-@rule.Id">Delivered-copy retention days</label><input id="retention-@rule.Id" class="form-control" type="number" min="0" name="RetentionDays" value="@rule.RetentionDays" /><div class="decision-actions"><button name="Action" value="PermanentlyAllow" class="btn btn-sm btn-success">Replace with allow</button><button name="Action" value="PermanentlyBlock" class="btn btn-sm btn-danger">Replace with block</button><button name="Action" value="TemporarilyAllow" class="btn btn-sm btn-warning">Replace with 7-day allow</button></div></form></details></div></article> }

@code {
    [CascadingParameter] public HttpContext HttpContext { get; set; } = null!;
    [SupplyParameterFromQuery] public string? View { get; set; }
    [SupplyParameterFromQuery] public Guid? SourceMailboxId { get; set; }
    [SupplyParameterFromQuery(Name = "outcome")] public string? OutcomeQuery { get; set; }
    [SupplyParameterFromQuery] public string? Search { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? Saved { get; set; }
    private IReadOnlyList<SourceMailboxSummary> _sources = [];
    private IReadOnlyList<MessageReviewItem> _recent = [];
    private IReadOnlyList<MessageReviewGroup> _senders = [];
    private IReadOnlyList<MessageReviewGroup> _subjects = [];
    private IReadOnlyList<ReviewRule> _rules = [];
    private RuleOutcome? Outcome => ReviewQueryParser.ParseOutcome(OutcomeQuery);
    protected override async Task OnInitializedAsync() { View = View?.ToLowerInvariant() is "sender" or "subject" ? View.ToLowerInvariant() : "recent"; var filter = new MessageReviewFilter(SourceMailboxId, Outcome, Search); _sources = await MailboxService.ListSourcesAsync(HttpContext.User); _recent = await ReviewService.GetRecentAsync(HttpContext.User, filter); if (View == "sender") _senders = await ReviewService.GetBySenderAsync(HttpContext.User, filter); if (View == "subject") _subjects = await ReviewService.GetBySubjectAsync(HttpContext.User, filter); _rules = await ReviewService.GetRulesAsync(HttpContext.User); }
    private string Link(string view) => $"/review?view={view}&sourceMailboxId={SourceMailboxId}&outcome={Outcome}&search={Uri.EscapeDataString(Search ?? string.Empty)}";
    private static string? SenderDomain(string sender) { var at = sender.LastIndexOf('@'); return at > 0 && at < sender.Length - 1 ? sender[(at + 1)..] : null; }
}
