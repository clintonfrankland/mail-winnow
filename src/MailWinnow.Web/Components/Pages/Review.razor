@page "/review"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@inject IMessageReviewService ReviewService
@inject IMailboxConfigurationService MailboxService
@inject IRuleManagementService RuleManagementService

<PageTitle>Message review</PageTitle>
<header class="page-heading"><div class="eyebrow">Decision center</div><h1>Message review</h1><p>Review recent mail and turn one-time decisions into reusable household rules.</p></header>
@if (!string.IsNullOrWhiteSpace(Error)) { <div class="alert alert-danger" role="alert">@Error</div> }
@if (!string.IsNullOrWhiteSpace(Saved)) { <div class="alert alert-success" role="status">@Saved</div> }

<form method="get" class="card section-card review-filter" aria-label="Message filters">
    <input type="hidden" name="view" value="@View" />
    <label>Account <select class="form-select" name="sourceMailboxId"><option value="">All accounts</option>@foreach (var source in _sources) { <option value="@source.Id" selected="@(SourceMailboxId == source.Id)">@source.DisplayName</option> }</select></label>
    <label>Sender or subject <input class="form-control" name="search" value="@Search" /></label>
    <button class="btn btn-primary">Apply filters</button>
</form>

<nav class="tabs mb-3" aria-label="Review view"><button type="button" class="btn @(View == "recent" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SwitchViewAsync("recent")'>Recent</button><button type="button" class="btn @(View == "sender" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SwitchViewAsync("sender")'>By sender</button><button type="button" class="btn @(View == "subject" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SwitchViewAsync("subject")'>By subject</button></nav>

@if (View == "recent")
{
    <p class="text-body-secondary small">Newest first. Messages disappear after a one-time decision or a matching sender/domain rule handles them.</p>
    @foreach (var item in _recent)
    {
        <article class="card review-card mb-2"><div class="review-card-header"><div><h2 class="h5">@item.Subject</h2><div class="review-meta">@item.Sender · @item.Account · @item.ReceivedUtc.ToString("u")</div></div><span class="pill">@item.Outcome</span></div><div class="review-facts"><div><strong>Source</strong>@item.SourceStatus</div><div><strong>Local delivery</strong>@item.DeliveryStatus</div><div><strong>Rule</strong>@item.RuleContext</div><div><strong>Retention</strong>@item.RetentionContext</div></div><div class="decision-actions">
            <select value="@RetentionValue(AddressKey(item.Id))" @onchange="e => SetRetention(AddressKey(item.Id), e.Value?.ToString())" aria-label="Destination retention"><option value="">Forever</option><option value="30">1 month</option><option value="7">1 week</option><option value="3">3 days</option><option value="1">1 day</option></select><button type="button" class="btn btn-sm btn-outline-success mt-2" @onclick="() => AllowAsync(item.Sender, RuleMatchType.ExactSender, AddressKey(item.Id))">Allow sender @item.Sender</button>
            <button type="button" class="btn btn-sm btn-outline-danger mt-2" @onclick="() => BlockAsync(item.Sender, RuleMatchType.ExactSender)">Block sender @item.Sender</button>
            @if (SenderDomain(item.Sender) is { } domain) { <button type="button" class="btn btn-sm btn-outline-success mt-2" @onclick="() => AllowAsync(domain, RuleMatchType.SenderDomain, AddressKey(item.Id))">Allow domain @domain</button> }
            @if (SenderDomain(item.Sender) is { } blockedDomain) { <button type="button" class="btn btn-sm btn-outline-danger mt-2" @onclick="() => BlockAsync(blockedDomain, RuleMatchType.SenderDomain)">Block domain @blockedDomain</button> }
        </div>
        </article>
    }
}
else
{
    var groups = View == "sender" ? _senders : _subjects;
    @foreach (var group in groups) { <article class="card review-card mb-2"><div class="review-card-header"><h2 class="h5">@group.Value</h2><span class="pill">@group.Count messages</span></div><div class="review-meta">Newest @group.MostRecentUtc.ToString("u")</div><div class="review-facts"><div><strong>Samples</strong>@string.Join("; ", group.Samples)</div><div><strong>Matching context</strong>@string.Join("; ", group.RuleContexts)</div></div><div class="decision-actions">
        @foreach (var sender in group.Senders) {
            <select value="@RetentionValue(GroupAddressKey(group.Value, sender))" @onchange="e => SetRetention(GroupAddressKey(group.Value, sender), e.Value?.ToString())" aria-label="Destination retention"><option value="">Forever</option><option value="30">1 month</option><option value="7">1 week</option><option value="3">3 days</option><option value="1">1 day</option></select><button type="button" class="btn btn-sm btn-outline-success mt-2" @onclick="() => AllowAsync(sender, RuleMatchType.ExactSender, GroupAddressKey(group.Value, sender))">Allow sender @sender</button>
            <button type="button" class="btn btn-sm btn-outline-danger mt-2" @onclick="() => BlockAsync(sender, RuleMatchType.ExactSender)">Block sender @sender</button>
            @if (SenderDomain(sender) is { } domain) { <button type="button" class="btn btn-sm btn-outline-success mt-2" @onclick="() => AllowAsync(domain, RuleMatchType.SenderDomain, GroupAddressKey(group.Value, sender))">Allow domain @domain</button> }
            @if (SenderDomain(sender) is { } blockedDomain) { <button type="button" class="btn btn-sm btn-outline-danger mt-2" @onclick="() => BlockAsync(blockedDomain, RuleMatchType.SenderDomain)">Block domain @blockedDomain</button> }
        }
    </div></article> }
}

<section class="card section-card mt-3"><div class="section-header"><div><h2>Reusable rules</h2><p class="text-body-secondary mb-0">View, create, edit, or remove automatic decisions on the Rules page.</p></div><a class="btn btn-outline-primary" href="/rules">Manage rules</a></div></section>

@code {
    [CascadingParameter] public Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;
    [SupplyParameterFromQuery] public string? View { get; set; }
    [SupplyParameterFromQuery] public Guid? SourceMailboxId { get; set; }
    [SupplyParameterFromQuery] public string? Search { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? Saved { get; set; }
    private IReadOnlyList<SourceMailboxSummary> _sources = [];
    private IReadOnlyList<MessageReviewItem> _recent = [];
    private IReadOnlyList<MessageReviewGroup> _senders = [];
    private IReadOnlyList<MessageReviewGroup> _subjects = [];
    private readonly Dictionary<string, int?> _retention = [];
    private ClaimsPrincipal User { get; set; } = null!;
    protected override async Task OnInitializedAsync() { User = (await AuthenticationStateTask).User; View = View?.ToLowerInvariant() is "sender" or "subject" ? View.ToLowerInvariant() : "recent"; await ReloadAsync(); }
    private async Task SwitchViewAsync(string view) { View = view; await ReloadAsync(); }
    private async Task ReloadAsync() { var filter = new MessageReviewFilter(SourceMailboxId, RuleOutcome.Pending, Search); _sources = await MailboxService.ListSourcesAsync(User); _recent = await ReviewService.GetRecentAsync(User, filter); _senders = View == "sender" ? await ReviewService.GetBySenderAsync(User, filter) : []; _subjects = View == "subject" ? await ReviewService.GetBySubjectAsync(User, filter) : []; }
    private async Task BlockAsync(string matchValue, RuleMatchType matchType)
    {
        Error = null;
        try
        {
            var owner = User.FindFirstValue(ClaimTypes.NameIdentifier) ?? throw new InvalidOperationException("The signed-in user could not be identified.");
            await RuleManagementService.AddOrUpdateAsync(new MailRule { OwnerUserId = owner, Action = RuleAction.PermanentlyBlock, Scope = RuleScope.User, MatchType = matchType, MatchValue = matchValue.Trim() });
            Saved = matchType == RuleMatchType.ExactSender ? $"Blocked sender {matchValue}." : $"Blocked domain {matchValue}.";
            await ReloadAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException) { Error = ex.Message; }
    }
    private async Task AllowAsync(string matchValue, RuleMatchType matchType, string retentionKey) => await ApplyAsync(async owner =>
    {
        await RuleManagementService.AddOrUpdateAsync(new MailRule { OwnerUserId = owner, Action = RuleAction.PermanentlyAllow, Scope = RuleScope.User, MatchType = matchType, MatchValue = matchValue.Trim(), DeliveredMessageRetentionDays = _retention.GetValueOrDefault(retentionKey) });
        Saved = matchType == RuleMatchType.ExactSender ? $"Allowed sender {matchValue}." : $"Allowed domain {matchValue}.";
    });
    private async Task ApplyAsync(Func<string, Task> action)
    {
        Error = null;
        try { var owner = User.FindFirstValue(ClaimTypes.NameIdentifier) ?? throw new InvalidOperationException("The signed-in user could not be identified."); await action(owner); await ReloadAsync(); }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException) { Error = ex.Message; }
    }
    private string RetentionValue(string key) => _retention.GetValueOrDefault(key)?.ToString() ?? string.Empty;
    private void SetRetention(string key, string? value) => _retention[key] = int.TryParse(value, out var days) ? days : null;
    private static string AddressKey(Guid id) => $"address:{id:N}";
    private static string GroupAddressKey(string group, string sender) => $"group-address:{group}:{sender}";
    private static string? SenderDomain(string sender) { var at = sender.LastIndexOf('@'); return at > 0 && at < sender.Length - 1 ? sender[(at + 1)..] : null; }
}
