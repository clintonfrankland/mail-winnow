@page "/review"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@inject IMessageReviewService ReviewService
@inject IMailboxConfigurationService MailboxService
@inject IRuleManagementService RuleManagementService

<PageTitle>Message review</PageTitle>
<header class="page-heading"><div class="eyebrow">Decision center</div><h1>Message review</h1><p>Review recent mail and turn one-time decisions into reusable household rules.</p></header>
@if (!string.IsNullOrWhiteSpace(Error)) { <div class="alert alert-danger" role="alert">@Error</div> }
@if (!string.IsNullOrWhiteSpace(Saved)) { <div class="alert alert-success" role="status">@Saved</div> }

<form method="get" class="card section-card review-filter" aria-label="Message filters">
    <input type="hidden" name="view" value="@View" />
    <label>Account <select class="form-select" name="sourceMailboxId"><option value="">All accounts</option>@foreach (var source in _sources) { <option value="@source.Id" selected="@(SourceMailboxId == source.Id)">@source.DisplayName</option> }</select></label>
    <label>Sender or subject <input class="form-control" name="search" value="@Search" /></label>
    <button class="btn btn-primary">Apply filters</button>
</form>

<nav class="tabs mb-3" aria-label="Review view"><button type="button" class="btn @(View == "recent" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SwitchViewAsync("recent")'>Recent</button><button type="button" class="btn @(View == "sender" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SwitchViewAsync("sender")'>By sender</button><button type="button" class="btn @(View == "subject" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SwitchViewAsync("subject")'>By subject</button></nav>

@if (View == "recent")
{
    <p class="text-body-secondary small">Newest first. Messages disappear after a matching sender or domain rule handles them.</p>
    @foreach (var item in _recent)
    {
        <article class="card review-card mb-2"><div class="review-card-header"><div><h2 class="h5">@item.Subject</h2><div class="review-meta">@item.Sender</div><div class="review-meta">Newest @item.ReceivedUtc.ToString("u")</div></div></div><div class="decision-actions">
            <ReviewDecisionActions Senders="@(new[] { item.Sender })" MessageIds="@(new[] { item.Id })" OnDecision="ApplyDecisionAsync" />
        </div>
        </article>
    }
}
else
{
    var groups = View == "sender" ? _senders : _subjects;
    @foreach (var group in groups) { <article class="card review-card mb-2"><div class="review-card-header"><div><h2 class="h5">@group.Value</h2>@if (View == "sender") { <div class="review-meta"><strong>Subjects:</strong> @string.Join("; ", group.Samples)</div> } else { <div class="review-meta"><strong>Senders:</strong> @string.Join("; ", group.Senders)</div> }<div class="review-meta">Newest @group.MostRecentUtc.ToString("u")</div></div><span class="pill">@group.Count messages</span></div><div class="decision-actions">
        <ReviewDecisionActions Senders="@group.Senders" MessageIds="@group.MessageIds" OnDecision="ApplyDecisionAsync" />
    </div></article> }
}

<section class="card section-card mt-3"><div class="section-header"><div><h2>Reusable rules</h2><p class="text-body-secondary mb-0">View, create, edit, or remove automatic decisions on the Rules page.</p></div><a class="btn btn-outline-primary" href="/rules">Manage rules</a></div></section>

@code {
    [CascadingParameter] public Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;
    [SupplyParameterFromQuery] public string? View { get; set; }
    [SupplyParameterFromQuery] public Guid? SourceMailboxId { get; set; }
    [SupplyParameterFromQuery] public string? Search { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? Saved { get; set; }
    private IReadOnlyList<SourceMailboxSummary> _sources = [];
    private IReadOnlyList<MessageReviewItem> _recent = [];
    private IReadOnlyList<MessageReviewGroup> _senders = [];
    private IReadOnlyList<MessageReviewGroup> _subjects = [];
    private ClaimsPrincipal User { get; set; } = null!;
    protected override async Task OnInitializedAsync() { User = (await AuthenticationStateTask).User; View = View?.ToLowerInvariant() is "sender" or "subject" ? View.ToLowerInvariant() : "recent"; await ReloadAsync(); }
    private async Task SwitchViewAsync(string view) { View = view; await ReloadAsync(); }
    private async Task ReloadAsync() { var filter = new MessageReviewFilter(SourceMailboxId, RuleOutcome.Pending, Search); _sources = await MailboxService.ListSourcesAsync(User); _recent = await ReviewService.GetRecentAsync(User, filter); _senders = View == "sender" ? await ReviewService.GetBySenderAsync(User, filter) : []; _subjects = View == "subject" ? await ReviewService.GetBySubjectAsync(User, filter) : []; }
    private async Task ApplyDecisionAsync(ReviewDecisionRequest decision) => await ApplyAsync(async owner =>
    {
        if (decision.Action == RuleAction.DeleteOneMessage)
        {
            foreach (var id in decision.MessageIds.Distinct()) await RuleManagementService.SetMessageDecisionAsync(new MessageDecision { OwnerUserId = owner, SourceMessageHeaderId = id, Action = RuleAction.DeleteOneMessage });
            Saved = decision.MessageIds.Count == 1 ? "Message queued for deletion." : $"{decision.MessageIds.Count} messages queued for deletion.";
            return;
        }
        await RuleManagementService.AddOrUpdateAsync(new MailRule { OwnerUserId = owner, Action = decision.Action, Scope = RuleScope.User, MatchType = decision.MatchType, MatchValue = decision.MatchValue.Trim(), DeliveredMessageRetentionDays = decision.RetentionDays });
        var verb = decision.Action == RuleAction.PermanentlyBlock ? "Blocked" : "Allowed";
        var target = decision.MatchType == RuleMatchType.ExactSender ? "sender" : "domain";
        Saved = $"{verb} {target} {decision.MatchValue}.";
    });
    private async Task ApplyAsync(Func<string, Task> action)
    {
        Error = null;
        try { var owner = User.FindFirstValue(ClaimTypes.NameIdentifier) ?? throw new InvalidOperationException("The signed-in user could not be identified."); await action(owner); await ReloadAsync(); }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException) { Error = ex.Message; }
    }
}
