@page "/inbox"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Security.Claims
@inject IInboxReaderService InboxReader
@inject IInboxDeletionQueue DeletionQueue

<PageTitle>Inbox</PageTitle>
<header class="page-heading"><h1>Inbox</h1></header>
@if (!string.IsNullOrWhiteSpace(_error)) { <div class="alert alert-danger" role="alert">@_error</div> }

<div class="inbox-shell" aria-busy="@_busy">
    <section class="inbox-list" aria-label="Messages">
        <header><strong>Inbox</strong><button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="LoadAsync">Refresh</button></header>
        @if (_busy && _messages.Count == 0) { <p class="inbox-empty">Loading messages…</p> }
        else if (_messages.Count == 0) { <p class="inbox-empty">No messages.</p> }
        @foreach (var message in _messages)
        {
            <button type="button" class="message-row @(_selected?.Uid == message.Uid ? "selected" : null)" @onclick="() => SelectAsync(message)">
                <span class="message-row-content">
                    <strong>@message.From</strong>
                    <span>@message.Subject</span>
                    <time>@message.Date.LocalDateTime.ToString("g")</time>
                </span>
            </button>
        }
    </section>
    <article class="inbox-reader" aria-label="Message reader">
        @if (_selected is null) { <div class="reader-empty">Select a message to read it.</div> }
        else
        {
            <div class="reader-actions" aria-label="Email actions">
                @if (_selected.HasRemoteImages && !_showImages)
                {
                    <button type="button" class="btn btn-sm btn-outline-primary" disabled="@_busy" @onclick="ShowImages"><svg class="button-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M14.002 3a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1h-12a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zm-12-1a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2z"/><path d="m10.648 7.646-2.5 3a.5.5 0 0 1-.768.015l-1.23-1.393-3.71 3.71A1 1 0 0 0 3 13h10a1 1 0 0 0 .864-.496l-2.753-4.858a.5.5 0 0 0-.463 0M5 6.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0"/></svg><span>Show images</span></button>
                }
                <button type="button" class="btn btn-sm btn-outline-danger" disabled="@_busy" @onclick="DeleteSelectedAsync" aria-label="Delete this email"><svg class="button-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/><path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/></svg><span>Delete</span></button>
            </div>
            <header class="reader-header"><div class="reader-heading"><h2>@_selected.Subject</h2><div><strong>From:</strong> @_selected.From</div><div><strong>To:</strong> @_selected.To</div><time>@_selected.Date.LocalDateTime.ToString("f")</time></div></header>
            <iframe class="message-body" @key="ViewerKey" title="Email message" sandbox="" referrerpolicy="no-referrer" srcdoc="@(_showImages ? _selected.HtmlBodyWithRemoteImages : _selected.HtmlBody)"></iframe>
        }
    </article>
</div>

@code {
    [CascadingParameter] public Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;
    private ClaimsPrincipal _user = null!;
    private IReadOnlyList<InboxMessageSummary> _messages = [];
    private InboxMessageContent? _selected;
    private string? _error;
    private bool _busy;
    private bool _showImages;
    private string ViewerKey => $"{_selected?.Uid}:{_showImages}";
    protected override async Task OnInitializedAsync() { _user = (await AuthenticationStateTask).User; await LoadAsync(); }
    private void ShowImages() => _showImages = true;
    private async Task LoadAsync() { _busy = true; _error = null; try { var result = await InboxReader.ListAsync(_user); if (result.Succeeded) _messages = result.Value ?? []; else _error = result.Error; } finally { _busy = false; } }
    private async Task SelectAsync(InboxMessageSummary summary) { _busy = true; _error = null; _showImages = false; try { var result = await InboxReader.ReadAsync(_user, summary.Uid, summary.UidValidity); if (result.Succeeded) _selected = result.Value; else _error = result.Error; } finally { _busy = false; } }
    private async Task DeleteSelectedAsync()
    {
        if (_selected is null || _busy) return;
        var deletedIndex = _messages.ToList().FindIndex(x => x.Uid == _selected.Uid);
        if (deletedIndex < 0) return;
        var deleted = _messages[deletedIndex];
        _messages = _messages.Where(x => x.Uid != deleted.Uid).ToArray();
        _selected = null;
        _showImages = false;
        StateHasChanged();

        var queued = await DeletionQueue.QueueAsync(_user, deleted.Uid, deleted.UidValidity);
        if (!queued.Succeeded)
        {
            var restored = _messages.ToList();
            restored.Insert(Math.Min(deletedIndex, restored.Count), deleted);
            _messages = restored;
            await SelectAsync(deleted);
            _error = queued.Message;
            return;
        }

        if (_messages.Count > 0)
            await SelectAsync(_messages[Math.Min(deletedIndex, _messages.Count - 1)]);
    }
}
