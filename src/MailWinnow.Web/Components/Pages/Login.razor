@page "/login"
@attribute [AllowAnonymous]
<PageTitle>Sign in</PageTitle>
<div class="auth-wrap"><section class="card auth-card"><img class="auth-mark" src="mail-winnow-mark.jpg" alt="Mail Winnow" /><div class="eyebrow">Welcome back</div><h1>Sign in to Mail Winnow</h1><p class="text-body-secondary">Access your private household mail workspace.</p>
@if (!string.IsNullOrWhiteSpace(Error)){<div class="alert alert-danger" role="alert">@Error</div>}
<form method="post" action="/auth/login" class="form-stack"><AntiforgeryToken /><label>Email address<input class="form-control" name="Email" type="email" autocomplete="username" required /></label><label>Password<input class="form-control" name="Password" type="password" autocomplete="current-password" required /></label><label class="form-check"><input class="form-check-input" name="RememberMe" type="checkbox" value="true" /> Keep me signed in</label><button class="btn btn-primary" type="submit">Sign in securely</button></form>
<p class="small text-body-secondary mt-3">Setting up a new installation? <a href="setup">First-run setup</a></p></section></div>
@code { [SupplyParameterFromQuery] public string? Error { get; set; } }
