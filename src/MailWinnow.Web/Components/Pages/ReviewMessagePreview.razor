@using MailWinnow.Infrastructure.Rules
@inject IReviewMessagePreviewService PreviewService

<section class="review-preview" aria-live="polite">
    @if (_loading) { <p class="review-meta">Loading message preview…</p> }
    else if (!string.IsNullOrWhiteSpace(_error)) { <div class="alert alert-warning mb-0" role="alert">@_error</div> }
    else if (_preview is not null)
    {
        <header><strong>@_preview.Subject</strong><div class="review-meta">From: @_preview.From</div><div class="review-meta">To: @_preview.To</div><div class="review-meta">Received: @_preview.ReceivedUtc.ToString("u")</div></header>
        <iframe class="review-preview-frame" title="Message preview: @_preview.Subject" sandbox="allow-popups" referrerpolicy="no-referrer" srcdoc="@_preview.HtmlBody"></iframe>
    }
</section>

@code {
    [Parameter, EditorRequired] public MessageReviewItem Item { get; set; } = null!;
    [CascadingParameter] public Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;
    private bool _loading = true;
    private string? _error;
    private MailWinnow.Infrastructure.Rules.ReviewMessagePreview? _preview;
    protected override async Task OnInitializedAsync()
    {
        var result = await PreviewService.ReadAsync((await AuthenticationStateTask).User, Item.Id);
        _preview = result.Value; _error = result.Succeeded ? null : result.Error ?? "Unable to load the message preview."; _loading = false;
    }
}
