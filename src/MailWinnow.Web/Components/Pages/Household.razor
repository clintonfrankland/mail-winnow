@page "/admin/household"
@attribute [Authorize(Policy = AuthConstants.AdministratorPolicy)]
@inject IHouseholdAccountService Accounts
<PageTitle>Household</PageTitle>
<header class="page-heading"><h1>Household accounts</h1></header>
@if (!string.IsNullOrWhiteSpace(Error)){<div class="alert alert-danger" role="alert">@Error</div>}else if(Saved){<div class="alert alert-success" role="status">Account updated successfully.</div>}
<section class="card section-card"><div class="section-header"><div><h2>Add a household member</h2><p class="text-body-secondary mb-0">They can change their temporary password after signing in.</p></div></div><form method="post" action="/auth/household/create" class="review-filter"><AntiforgeryToken /><label>Email address<input class="form-control" name="Email" type="email" autocomplete="off" placeholder="name@example.com" required /></label><label>Temporary password<input class="form-control" name="Password" type="password" minlength="12" autocomplete="new-password" placeholder="At least 12 characters" required /></label><span></span><button class="btn btn-primary" type="submit">Create account</button></form></section>
<section><div class="section-header"><div><h2>Current accounts</h2><p class="text-body-secondary mb-0">@_accounts.Count household account@(_accounts.Count==1?"":"s")</p></div></div><div class="stack">@foreach(var account in _accounts){<article class="list-row"><div class="list-row-main"><strong>@account.Email</strong><div class="small text-body-secondary mt-1"><span class="pill">@(account.IsAdministrator?"Administrator":"Household user")</span> <span class="pill @(account.IsEnabled?"pill-success":"pill-warning")">@(account.IsEnabled?"Enabled":"Disabled")</span></div></div><div class="list-row-actions"><form method="post" action="/auth/household/enabled"><AntiforgeryToken /><input type="hidden" name="UserId" value="@account.Id"/><input type="hidden" name="Enabled" value="@(!account.IsEnabled)"/><button class="btn btn-outline-secondary btn-sm" type="submit">@(account.IsEnabled?"Disable":"Enable")</button></form><details><summary class="btn btn-outline-secondary btn-sm">Reset password</summary><form method="post" action="/auth/household/password" class="card card-body form-stack mt-2"><AntiforgeryToken /><input type="hidden" name="UserId" value="@account.Id"/><label>New password<input class="form-control" name="Password" type="password" minlength="12" autocomplete="new-password" required /></label><button class="btn btn-primary btn-sm" type="submit">Save new password</button></form></details></div></article>}</div></section>
@code { [CascadingParameter] public HttpContext HttpContext { get; set; }=null!; [SupplyParameterFromQuery] public string? Error{get;set;} [SupplyParameterFromQuery] public bool Saved{get;set;} private IReadOnlyList<HouseholdAccount> _accounts=[]; protected override async Task OnInitializedAsync()=>_accounts=await Accounts.ListAsync(HttpContext.User); }
