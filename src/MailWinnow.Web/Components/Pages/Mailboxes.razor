@page "/mailboxes"
@attribute [Authorize]
@inject IMailboxConfigurationService MailboxService

<PageTitle>Mailboxes</PageTitle>
<h1>Mailboxes</h1>
@if (!string.IsNullOrWhiteSpace(Error)) { <div class="alert alert-danger">@Error</div> }
@if (!string.IsNullOrWhiteSpace(Saved)) { <div class="alert alert-success">@Saved</div> }

<h2>Source IMAP accounts</h2>
@foreach (var source in _sources)
{
    <section class="card p-3 mb-3">
        <strong>@source.DisplayName</strong> — @source.Username@@@source.Host:@source.Port (@(source.UseSsl ? "TLS" : "STARTTLS"))
        <div>@(source.Enabled ? "Enabled" : "Disabled") · @source.PollingStatus · @(source.LastSuccessfulConnectionUtc?.ToString("u") ?? "Not tested")</div>
        @if (!string.IsNullOrWhiteSpace(source.SanitizedError)) { <div class="text-danger">@source.SanitizedError</div> }
        <form method="post" action="/mailboxes/source/enabled" class="d-inline"><AntiforgeryToken /><input type="hidden" name="Id" value="@source.Id" /><input type="hidden" name="Enabled" value="@(!source.Enabled)" /><button class="btn btn-secondary mt-2">@(source.Enabled ? "Disable" : "Enable")</button></form>
        <form method="post" action="/mailboxes/source/test" class="d-inline"><AntiforgeryToken /><input type="hidden" name="Id" value="@source.Id" /><input type="hidden" name="DiscoverFolders" value="true" /><button class="btn btn-secondary mt-2">Test and discover folders</button></form>
        <details class="mt-2"><summary>Edit</summary><form method="post" action="/mailboxes/source/save"><AntiforgeryToken /><input type="hidden" name="Id" value="@source.Id" /><input type="hidden" name="Enabled" value="@source.Enabled" /><input class="form-control mb-2" name="DisplayName" value="@source.DisplayName" required /><input class="form-control mb-2" name="Host" value="@source.Host" required /><input class="form-control mb-2" name="Port" type="number" value="@source.Port" required /><input class="form-control mb-2" name="Username" value="@source.Username" required /><input class="form-control mb-2" name="Password" type="password" placeholder="New password (leave blank to keep current)" /><input class="form-control mb-2" name="SelectedFolders" value="@string.Join(',', source.SelectedFolders)" placeholder="Selected folders, comma-separated" /><label><input name="UseSsl" type="checkbox" value="true" checked="@source.UseSsl" /> Use TLS</label><button class="btn btn-primary mt-2">Save changes</button></form></details>
    </section>
}
<form method="post" action="/mailboxes/source/save" class="card p-3 mb-4">
    <h3>Add source account</h3><AntiforgeryToken />
    <input class="form-control mb-2" name="DisplayName" placeholder="Display name" required />
    <input class="form-control mb-2" name="Host" placeholder="IMAP host" required />
    <input class="form-control mb-2" name="Port" type="number" min="1" max="65535" value="993" required />
    <input class="form-control mb-2" name="Username" placeholder="Username" required />
    <input class="form-control mb-2" name="Password" type="password" placeholder="Password (stored encrypted)" required />
    <input class="form-control mb-2" name="SelectedFolders" placeholder="Selected folders, comma-separated" />
    <label><input name="UseSsl" type="checkbox" value="true" checked /> Use TLS</label><input type="hidden" name="Enabled" value="true" />
    <button class="btn btn-primary mt-2">Save source</button>
</form>

<h2>Destination mailbox</h2>
<form method="post" action="/mailboxes/destination/save" class="card p-3">
    <AntiforgeryToken /><input class="form-control mb-2" name="Username" value="@_destination?.Username" placeholder="Destination username" required />
    <input class="form-control mb-2" name="Password" type="password" placeholder="@(_destination is null ? "Password (stored encrypted)" : "New password (leave blank to keep current)")" required="@(_destination is null)" />
    <input class="form-control mb-2" name="Folder" value="@_destination?.Folder" placeholder="Destination folder" required />
    <label><input name="Enabled" type="checkbox" value="true" checked="@(_destination?.Enabled ?? true)" /> Enabled</label>
    <button class="btn btn-primary mt-2">Save destination</button>
</form>

@code {
    [CascadingParameter] public HttpContext HttpContext { get; set; } = null!;
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? Saved { get; set; }
    private IReadOnlyList<SourceMailboxSummary> _sources = [];
    private DestinationMailboxSummary? _destination;
    protected override async Task OnInitializedAsync() { _sources = await MailboxService.ListSourcesAsync(HttpContext.User); _destination = await MailboxService.GetDestinationAsync(HttpContext.User); }
}
