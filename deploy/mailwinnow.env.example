# Home Helm writes an environment-specific managed copy of this contract.
# Never commit real connection strings or mailbox credentials.
ConnectionStrings__MailWinnow=REQUIRED_SECRET
LocalImap__Host=mailwinnow-imap.clintandtara.com
LocalImap__Port=993
LocalImap__UseSsl=true
LocalImap__AllowInvalidCertificate=false
DataProtection__KeysPath=/var/lib/mailwinnow/data-protection-keys
MailSync__PollingIntervalSeconds=60
MailSync__BatchSize=100
MailSync__MaximumConcurrency=4
MAILWINNOW_PORT=9080
